model PriceList {
  id                String          @id @default(uuid())
  businessAccountId String          @map("business_account_id")
  name              String
  currency          String          @default("NGN")
  status            String          @default("active")
  validFrom         DateTime        @default(now()) @map("valid_from")
  validUntil        DateTime?       @map("valid_until")
  createdAt         DateTime        @default(now()) @map("created_at")
  business          BusinessAccount @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  items             PriceListItem[]

  @@index([businessAccountId, status])
  @@map("price_lists")
}

model PriceListItem {
  id          String    @id @default(uuid())
  priceListId String    @map("price_list_id")
  skuId       String    @map("sku_id")
  unitPrice   Decimal   @map("unit_price") @db.Decimal(18, 4)
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  sku         ProductSku @relation(fields: [skuId], references: [id])

  @@unique([priceListId, skuId])
  @@map("price_list_items")
}

model VendorStock {
  vendorId    String @map("vendor_id")
  skuId       String @map("sku_id")
  onHandQty   Int    @default(0) @map("on_hand_qty")
  reservedQty Int    @default(0) @map("reserved_qty")
  vendor      Vendor @relation(fields: [vendorId], references: [id])
  sku         ProductSku @relation(fields: [skuId], references: [id])

  @@id([vendorId, skuId])
  @@map("vendor_stock")
}

model VendorReservation {
  id          String   @id @default(uuid())
  vendorId    String   @map("vendor_id")
  skuId       String   @map("sku_id")
  orderItemId String   @map("order_item_id")
  qty         Int
  status      String   @default("active")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([orderItemId])
  @@index([status, expiresAt])
  @@map("vendor_reservations")
}

model VendorLedger {
  id        String   @id @default(uuid())
  vendorId  String   @map("vendor_id")
  orderId   String?  @map("order_id")
  kind      String
  amount    Decimal  @db.Decimal(18, 4)
  reference String?
  createdAt DateTime @default(now()) @map("created_at")
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  order     Order?   @relation(fields: [orderId], references: [id])

  @@index([vendorId, createdAt])
  @@index([orderId])
  @@map("vendor_ledger")
}
