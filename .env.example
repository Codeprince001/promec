NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
TZ=Africa/Lagos

DATABASE_URL=postgresql://postgres:promec@localhost:5432/promec
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=dev-only-change-me-please
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

PAYSTACK_SECRET_KEY=
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
OPENSEARCH_NODE=
COURIER_WEBHOOK_SECRET=

# Resend (https://resend.com/api-keys). Domain must be verified.
RESEND_API_KEY=
RESEND_FROM=PROMEC <notifications@your-domain.com>

# Termii SMS and WhatsApp (https://termii.com). Leave blank until the sender ID is approved.
TERMII_API_KEY=
TERMII_SENDER=PROMEC

# GIG Logistics third-party account (https://gig-logistics.readme.io)
GIG_API_BASE=https://thirdpartynode.theagilitysystems.com
GIG_EMAIL=
GIG_PASSWORD=
GIG_SENDER_STATION_ID=

# DHL Express MyDHL API. Credentials come from a DHL Express consultant.
DHL_API_BASE=https://express.api.dhl.com/mydhlapi
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=

# S3-compatible uploads (AWS S3, Cloudflare R2, or MinIO).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Public NHTSA VIN decoder. No key. Override only if you run a private decoder.
VIN_DECODE_URL=https://vpic.nhtsa.dot.gov/api

# Account customers pay when they choose bank transfer.
BANK_ACCOUNT_NAME=PROMEC Limited
BANK_NAME=
BANK_ACCOUNT_NUMBER=
FEATURE_NL_SEARCH=true
FEATURE_GUEST_CHECKOUT=true
AI_PROVIDER=none
AI_API_KEY=
