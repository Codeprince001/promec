generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  customer
  staff
  vendor
  supplier
}

enum UserStatus {
  active
  disabled
  pending
}

enum CustomerType {
  individual
  mechanic
  business_member
}

enum FitmentStatus {
  confirmed
  probable
  unverified
  incompatible
}

enum ProductStatus {
  draft
  in_review
  published
  archived
}

enum PartCondition {
  new
  used
  refurbished
}

enum OrderStatus {
  pending_payment
  payment_failed
  paid
  awaiting_stock
  processing
  packed
  dispatched
  delivered
  completed
  cancelled
  return_requested
  returned
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  partially_refunded
}

enum FulfilmentStatus {
  unfulfilled
  partial
  fulfilled
  cancelled
}

enum TicketStatus {
  open
  pending
  resolved
  closed
}

model User {
  id           String     @id @default(uuid())
  email        String?    @unique
  phone        String?    @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(active)
  userType     UserType   @default(customer) @map("user_type")
  mfaEnabled   Boolean    @default(false) @map("mfa_enabled")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  customer       Customer?
  roles          UserRole[]
  sessions       Session[]
  mfaChallenges  MfaChallenge[]
  auditLogs      AuditLog[]
  vendor         Vendor?
  assignedTickets SupportTicket[] @relation("TicketAssignee")

  @@map("users")
}

model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  familyId  String    @map("family_id")
  ip        String?
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
  @@map("sessions")
}

model MfaChallenge {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_challenges")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  module      String
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  scope        String     @default("all")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId      String     @map("user_id")
  roleId      String     @map("role_id")
  warehouseId String?    @map("warehouse_id")
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  @@id([userId, roleId])
  @@index([warehouseId])
  @@map("user_roles")
}

model Customer {
  id               String       @id @default(uuid())
  userId           String       @unique @map("user_id")
  firstName        String       @map("first_name")
  lastName         String       @map("last_name")
  customerType     CustomerType @default(individual) @map("customer_type")
  marketingConsent Boolean      @default(false) @map("marketing_consent")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  addresses    CustomerAddress[]
  vehicles     CustomerVehicle[]
  carts        Cart[]
  orders       Order[]
  wishlist     WishlistItem[]
  tickets      SupportTicket[]
  partRequests PartRequest[]
  businessUsers BusinessUser[]

  @@map("customers")
}

model CustomerAddress {
  id                String   @id @default(uuid())
  customerId        String   @map("customer_id")
  label             String?
  recipient         String
  phone             String
  state             String
  lga               String?
  city              String
  street            String
  landmark          String?
  isDefaultShipping Boolean  @default(false) @map("is_default_shipping")
  isDefaultBilling  Boolean  @default(false) @map("is_default_billing")
  createdAt         DateTime @default(now()) @map("created_at")
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model BusinessAccount {
  id                   String    @id @default(uuid())
  legalName            String    @map("legal_name")
  cacNumber            String?   @unique @map("cac_number")
  tin                  String?
  industry             String?
  status               String    @default("pending")
  creditLimit          Decimal   @default(0) @map("credit_limit") @db.Decimal(18, 4)
  paymentTermsDays     Int       @default(0) @map("payment_terms_days")
  accountManagerUserId String?   @map("account_manager_user_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  users                BusinessUser[]
  orders               Order[]
  quotes               Quote[]

  @@map("business_accounts")
}

model BusinessUser {
  id                String          @id @default(uuid())
  businessAccountId String          @map("business_account_id")
  customerId        String          @map("customer_id")
  businessRole      String          @map("business_role")
  spendingLimit     Decimal?        @map("spending_limit") @db.Decimal(18, 4)
  business          BusinessAccount @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([businessAccountId, customerId])
  @@map("business_users")
}

model CustomerVehicle {
  id               String         @id @default(uuid())
  customerId       String         @map("customer_id")
  vehicleVariantId String         @map("vehicle_variant_id")
  nickname         String?
  year             Int?
  vinEnc           String?        @map("vin_enc")
  plateEnc         String?        @map("plate_enc")
  odometer         Int?
  isDefault        Boolean        @default(false) @map("is_default")
  createdAt        DateTime       @default(now()) @map("created_at")
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  variant          VehicleVariant @relation(fields: [vehicleVariantId], references: [id])

  @@index([customerId])
  @@map("customer_vehicles")
}

model VehicleMake {
  id           String         @id @default(uuid())
  name         String
  slug         String         @unique
  country      String?
  isCommercial Boolean        @default(false) @map("is_commercial")
  models       VehicleModel[]

  @@map("vehicle_makes")
}

model VehicleModel {
  id           String           @id @default(uuid())
  makeId       String           @map("make_id")
  name         String
  slug         String
  generation   String?
  yearFrom     Int              @map("year_from")
  yearTo       Int              @map("year_to")
  vehicleClass String           @default("passenger") @map("vehicle_class")
  make         VehicleMake      @relation(fields: [makeId], references: [id])
  variants     VehicleVariant[]

  @@unique([makeId, slug, generation])
  @@index([makeId])
  @@map("vehicle_models")
}

model Engine {
  id             String           @id @default(uuid())
  code           String
  displacementCc Int?             @map("displacement_cc")
  cylinders      Int?
  fuelType       String?          @map("fuel_type")
  aspiration     String?
  variants       VehicleVariant[]

  @@unique([code])
  @@map("engines")
}

model VehicleVariant {
  id             String                @id @default(uuid())
  modelId        String                @map("model_id")
  engineId       String?               @map("engine_id")
  yearFrom       Int                   @map("year_from")
  yearTo         Int                   @map("year_to")
  market         String?
  trim           String?
  drivetrain     String?
  transmission   String?
  fuelType       String?               @map("fuel_type")
  model          VehicleModel          @relation(fields: [modelId], references: [id])
  engine         Engine?               @relation(fields: [engineId], references: [id])
  compatibility  VehicleCompatibility[]
  garage         CustomerVehicle[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([modelId, yearFrom, yearTo])
  @@map("vehicle_variants")
}

model CompatibilitySource {
  id         String                 @id @default(uuid())
  name       String
  type       String
  priority   Int                    @default(0)
  records    VehicleCompatibility[]

  @@map("compatibility_sources")
}

model VehicleCompatibility {
  id               String            @id @default(uuid())
  productId        String            @map("product_id")
  skuId            String?           @map("sku_id")
  makeId           String?           @map("make_id")
  modelId          String?           @map("model_id")
  vehicleVariantId String?           @map("vehicle_variant_id")
  yearFrom         Int?              @map("year_from")
  yearTo           Int?              @map("year_to")
  engineId         String?           @map("engine_id")
  status           FitmentStatus
  position         String?
  side             String?
  qtyPerVehicle    Int?              @map("qty_per_vehicle")
  notes            String?
  sourceId         String?           @map("source_id")
  confidence       Decimal?          @db.Decimal(4, 3)
  verifiedAt       DateTime?         @map("verified_at")
  approvedById     String?           @map("approved_by_id")
  validFrom        DateTime?         @map("valid_from")
  validTo          DateTime?         @map("valid_to")
  createdAt        DateTime          @default(now()) @map("created_at")
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          VehicleVariant?   @relation(fields: [vehicleVariantId], references: [id])
  source           CompatibilitySource? @relation(fields: [sourceId], references: [id])

  @@index([productId])
  @@index([vehicleVariantId, status])
  @@map("vehicle_compatibility")
}

model Manufacturer {
  id       String    @id @default(uuid())
  name     String    @unique
  country  String?
  type     String    @default("aftermarket")
  logoUrl  String?   @map("logo_url")
  products Product[]
  partNumbers PartNumber[]

  @@map("manufacturers")
}

model Category {
  id          String     @id @default(uuid())
  parentId    String?    @map("parent_id")
  name        String
  slug        String     @unique
  path        String
  description String?
  sortOrder   Int        @default(0) @map("sort_order")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId])
  @@index([path])
  @@map("categories")
}

model Product {
  id              String         @id @default(uuid())
  name            String
  slug            String         @unique
  manufacturerId  String         @map("manufacturer_id")
  categoryId      String         @map("category_id")
  description     String?
  attributes      Json?
  condition       PartCondition  @default(new)
  status          ProductStatus  @default(draft)
  warrantyMonths  Int            @default(0) @map("warranty_months")
  originCountry   String?        @map("origin_country")
  isUniversal     Boolean        @default(false) @map("is_universal")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")
  manufacturer    Manufacturer   @relation(fields: [manufacturerId], references: [id])
  category        Category       @relation(fields: [categoryId], references: [id])
  skus            ProductSku[]
  media           ProductMedia[]
  partNumbers     PartNumber[]
  compatibility   VehicleCompatibility[]
  vendorId        String?        @map("vendor_id")
  vendor          Vendor?        @relation(fields: [vendorId], references: [id])

  @@index([categoryId])
  @@index([manufacturerId])
  @@index([status])
  @@map("products")
}

model ProductSku {
  id           String   @id @default(uuid())
  productId    String   @map("product_id")
  sku          String   @unique
  barcode      String?
  weightG      Int      @default(0) @map("weight_g")
  lengthMm     Int?     @map("length_mm")
  widthMm      Int?     @map("width_mm")
  heightMm     Int?     @map("height_mm")
  sellingPrice Decimal  @map("selling_price") @db.Decimal(18, 4)
  currencyCode String   @default("NGN") @map("currency_code")
  status       String   @default("active")
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory    Inventory[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  suppliers    ProductSupplier[]
  wishlist     WishlistItem[]

  @@index([productId])
  @@map("product_skus")
}

model ProductMedia {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  url       String
  alt       String?
  sortOrder Int     @default(0) @map("sort_order")
  type      String  @default("image")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_media")
}

model PartNumber {
  id             String        @id @default(uuid())
  productId      String        @map("product_id")
  number         String
  normalized     String
  type           String
  manufacturerId String?       @map("manufacturer_id")
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])
  fromRefs       PartCrossReference[] @relation("FromPart")
  toRefs         PartCrossReference[] @relation("ToPart")

  @@index([normalized])
  @@index([productId])
  @@map("part_numbers")
}

model PartCrossReference {
  id               String     @id @default(uuid())
  fromPartNumberId String     @map("from_part_number_id")
  toPartNumberId   String     @map("to_part_number_id")
  relation         String
  fromPart         PartNumber @relation("FromPart", fields: [fromPartNumberId], references: [id], onDelete: Cascade)
  toPart           PartNumber @relation("ToPart", fields: [toPartNumberId], references: [id], onDelete: Cascade)

  @@index([fromPartNumberId])
  @@index([toPartNumberId])
  @@map("part_cross_references")
}

model ProductSupplier {
  productSkuId   String   @map("product_sku_id")
  supplierId     String   @map("supplier_id")
  supplierPartNo String?  @map("supplier_part_no")
  costPrice      Decimal  @map("cost_price") @db.Decimal(18, 4)
  costCurrency   String   @default("USD") @map("cost_currency")
  moq            Int      @default(1)
  leadTimeDays   Int      @default(21) @map("lead_time_days")
  isPreferred    Boolean  @default(false) @map("is_preferred")
  sku            ProductSku @relation(fields: [productSkuId], references: [id], onDelete: Cascade)
  supplier       Supplier   @relation(fields: [supplierId], references: [id])

  @@id([productSkuId, supplierId])
  @@map("product_suppliers")
}

model Warehouse {
  id        String      @id @default(uuid())
  code      String      @unique
  name      String
  address   String?
  state     String?
  isActive  Boolean     @default(true) @map("is_active")
  inventory Inventory[]
  shipments Shipment[]
  staff     UserRole[]

  @@map("warehouses")
}

model Inventory {
  id           String   @id @default(uuid())
  skuId        String   @map("sku_id")
  warehouseId  String   @map("warehouse_id")
  onHandQty    Int      @default(0) @map("on_hand_qty")
  reservedQty  Int      @default(0) @map("reserved_qty")
  reorderPoint Int      @default(0) @map("reorder_point")
  avgCost      Decimal  @default(0) @map("avg_cost") @db.Decimal(18, 4)
  sku          ProductSku @relation(fields: [skuId], references: [id])
  warehouse    Warehouse  @relation(fields: [warehouseId], references: [id])
  movements    StockMovement[]
  reservations InventoryReservation[]

  @@unique([skuId, warehouseId])
  @@map("inventory")
}

model StockMovement {
  id            String    @id @default(uuid())
  inventoryId   String    @map("inventory_id")
  movementType  String    @map("movement_type")
  qty           Int
  unitCost      Decimal?  @map("unit_cost") @db.Decimal(18, 4)
  referenceType String?   @map("reference_type")
  referenceId   String?   @map("reference_id")
  reason        String?
  userId        String?   @map("user_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  inventory     Inventory @relation(fields: [inventoryId], references: [id])

  @@index([inventoryId, createdAt])
  @@map("stock_movements")
}

model InventoryReservation {
  id          String    @id @default(uuid())
  inventoryId String    @map("inventory_id")
  orderItemId String?   @map("order_item_id")
  qty         Int
  status      String    @default("active")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])

  @@index([expiresAt, status])
  @@map("inventory_reservations")
}

model Cart {
  id          String     @id @default(uuid())
  customerId  String?    @map("customer_id")
  guestToken  String?    @unique @map("guest_token")
  currencyCode String    @default("NGN") @map("currency_code")
  status      String     @default("open")
  expiresAt   DateTime?  @map("expires_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  customer    Customer?  @relation(fields: [customerId], references: [id])
  items       CartItem[]

  @@index([customerId])
  @@map("carts")
}

model CartItem {
  id                    String          @id @default(uuid())
  cartId                String          @map("cart_id")
  skuId                 String          @map("sku_id")
  qty                   Int
  vehicleVariantId      String?         @map("vehicle_variant_id")
  fitmentStatusSnapshot FitmentStatus?  @map("fitment_status_snapshot")
  unitPriceSnapshot     Decimal         @map("unit_price_snapshot") @db.Decimal(18, 4)
  cart                  Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku                   ProductSku      @relation(fields: [skuId], references: [id])
  variant               VehicleVariant? @relation(fields: [vehicleVariantId], references: [id])

  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id                String           @id @default(uuid())
  orderNo           String           @unique @map("order_no")
  customerId        String?          @map("customer_id")
  businessAccountId String?          @map("business_account_id")
  contactEmail      String?          @map("contact_email")
  contactPhone      String?          @map("contact_phone")
  status            OrderStatus      @default(pending_payment)
  paymentStatus     PaymentStatus    @default(pending) @map("payment_status")
  fulfilmentStatus  FulfilmentStatus @default(unfulfilled) @map("fulfilment_status")
  currencyCode      String           @default("NGN") @map("currency_code")
  subtotal          Decimal          @db.Decimal(18, 4)
  discountTotal     Decimal          @default(0) @map("discount_total") @db.Decimal(18, 4)
  shippingTotal     Decimal          @default(0) @map("shipping_total") @db.Decimal(18, 4)
  taxTotal          Decimal          @default(0) @map("tax_total") @db.Decimal(18, 4)
  grandTotal        Decimal          @map("grand_total") @db.Decimal(18, 4)
  couponCode        String?          @map("coupon_code")
  deliveryMethod    String           @default("courier") @map("delivery_method")
  shippingAddress   Json?            @map("shipping_address")
  notes             String?
  placedAt          DateTime         @default(now()) @map("placed_at")
  customer          Customer?        @relation(fields: [customerId], references: [id])
  business          BusinessAccount? @relation(fields: [businessAccountId], references: [id])
  items             OrderItem[]
  payments          Payment[]
  shipments         Shipment[]
  returns           ReturnRequest[]

  @@index([customerId, placedAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id               String          @id @default(uuid())
  orderId          String          @map("order_id")
  skuId            String          @map("sku_id")
  qty              Int
  unitPrice        Decimal         @map("unit_price") @db.Decimal(18, 4)
  vehicleVariantId String?         @map("vehicle_variant_id")
  fitmentStatus    FitmentStatus?  @map("fitment_status")
  warrantyMonths   Int             @default(0) @map("warranty_months")
  status           String          @default("pending")
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku              ProductSku      @relation(fields: [skuId], references: [id])
  variant          VehicleVariant? @relation(fields: [vehicleVariantId], references: [id])
  reservations     InventoryReservation[]

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id           String        @id @default(uuid())
  orderId      String        @map("order_id")
  provider     String
  providerRef  String        @unique @map("provider_ref")
  amount       Decimal       @db.Decimal(18, 4)
  currency     String        @default("NGN")
  feeAmount    Decimal       @default(0) @map("fee_amount") @db.Decimal(18, 4)
  status       PaymentStatus @default(pending)
  method       String
  verifiedAt   DateTime?     @map("verified_at")
  rawResponse  Json?         @map("raw_response")
  createdAt    DateTime      @default(now()) @map("created_at")
  order        Order         @relation(fields: [orderId], references: [id])
  refunds      Refund[]

  @@index([orderId])
  @@map("payments")
}

model Refund {
  id         String        @id @default(uuid())
  paymentId  String        @map("payment_id")
  orderId    String        @map("order_id")
  amount     Decimal       @db.Decimal(18, 4)
  reason     String?
  status     PaymentStatus @default(pending)
  approvedBy String?       @map("approved_by")
  createdAt  DateTime      @default(now()) @map("created_at")
  payment    Payment       @relation(fields: [paymentId], references: [id])

  @@index([orderId])
  @@map("refunds")
}

model ReturnRequest {
  id           String   @id @default(uuid())
  orderId      String   @map("order_id")
  reasonCode   String   @map("reason_code")
  notes        String?
  evidenceUrls Json?    @map("evidence_urls")
  status       String   @default("requested")
  createdAt    DateTime @default(now()) @map("created_at")
  order        Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("return_requests")
}

model Shipment {
  id          String          @id @default(uuid())
  orderId     String          @map("order_id")
  warehouseId String?         @map("warehouse_id")
  courierName String?         @map("courier_name")
  trackingNo  String?         @map("tracking_no")
  status      String          @default("pending")
  fee         Decimal         @default(0) @db.Decimal(18, 4)
  shippedAt   DateTime?       @map("shipped_at")
  deliveredAt DateTime?       @map("delivered_at")
  order       Order           @relation(fields: [orderId], references: [id])
  warehouse   Warehouse?      @relation(fields: [warehouseId], references: [id])
  events      ShipmentEvent[]

  @@index([orderId])
  @@index([trackingNo])
  @@map("shipments")
}

model ShipmentEvent {
  id         String   @id @default(uuid())
  shipmentId String   @map("shipment_id")
  status     String
  location   String?
  note       String?
  source     String   @default("system")
  occurredAt DateTime @default(now()) @map("occurred_at")
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

model DeliveryZone {
  id       String  @id @default(uuid())
  name     String
  states   String[]
  baseFee  Decimal @map("base_fee") @db.Decimal(18, 4)
  perKgFee Decimal @map("per_kg_fee") @db.Decimal(18, 4)
  currency String  @default("NGN")
  isActive Boolean @default(true) @map("is_active")

  @@map("delivery_zones")
}

model Supplier {
  id            String   @id @default(uuid())
  legalName     String   @map("legal_name")
  country       String
  tier          Int      @default(2)
  status        String   @default("pending")
  currency      String   @default("USD")
  paymentTerms  String?  @map("payment_terms")
  email         String?
  createdAt     DateTime @default(now()) @map("created_at")
  products      ProductSupplier[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model Vendor {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  businessName    String    @map("business_name")
  status          String    @default("pending")
  fulfilmentMode  String    @default("promec") @map("fulfilment_mode")
  commissionRate  Decimal   @default(0.12) @map("commission_rate") @db.Decimal(6, 4)
  createdAt       DateTime  @default(now()) @map("created_at")
  user            User      @relation(fields: [userId], references: [id])
  products        Product[]

  @@map("vendors")
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  poNo         String              @unique @map("po_no")
  supplierId   String              @map("supplier_id")
  currency     String
  incoterm     String?
  status       String              @default("draft")
  total        Decimal             @default(0) @db.Decimal(18, 4)
  expectedDate DateTime?           @map("expected_date")
  createdAt    DateTime            @default(now()) @map("created_at")
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  items        PurchaseOrderItem[]
  imports      ImportRecord[]

  @@index([supplierId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String        @map("purchase_order_id")
  description     String
  qty             Int
  unitPrice       Decimal       @map("unit_price") @db.Decimal(18, 4)
  weightKg        Decimal       @default(0) @map("weight_kg") @db.Decimal(12, 3)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model ImportRecord {
  id         String        @id @default(uuid())
  poId       String?       @map("po_id")
  mode       String
  status     String        @default("planned")
  blAwbNo    String?       @map("bl_awb_no")
  etd        DateTime?
  eta        DateTime?
  dutyTotal  Decimal       @default(0) @map("duty_total") @db.Decimal(18, 4)
  notes      String?
  createdAt  DateTime      @default(now()) @map("created_at")
  purchaseOrder PurchaseOrder? @relation(fields: [poId], references: [id])

  @@index([status, eta])
  @@map("import_records")
}

model PartRequest {
  id               String    @id @default(uuid())
  customerId       String?   @map("customer_id")
  contactEmail     String?   @map("contact_email")
  vehicleVariantId String?   @map("vehicle_variant_id")
  vin              String?
  description      String
  partNumber       String?   @map("part_number")
  status           String    @default("received")
  createdAt        DateTime  @default(now()) @map("created_at")
  customer         Customer? @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("part_requests")
}

model Quote {
  id                String          @id @default(uuid())
  quoteNo           String          @unique @map("quote_no")
  businessAccountId String?         @map("business_account_id")
  customerId        String?         @map("customer_id")
  status            String          @default("draft")
  currencyCode      String          @default("NGN") @map("currency_code")
  validUntil        DateTime?       @map("valid_until")
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at")
  business          BusinessAccount? @relation(fields: [businessAccountId], references: [id])
  items             QuoteItem[]

  @@map("quotes")
}

model QuoteItem {
  id          String  @id @default(uuid())
  quoteId     String  @map("quote_id")
  description String
  qty         Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(18, 4)
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_items")
}

model WishlistItem {
  id               String     @id @default(uuid())
  customerId       String     @map("customer_id")
  skuId            String     @map("sku_id")
  alertPriceDrop   Boolean    @default(false) @map("alert_price_drop")
  alertRestock     Boolean    @default(true) @map("alert_restock")
  createdAt        DateTime   @default(now()) @map("created_at")
  customer         Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sku              ProductSku @relation(fields: [skuId], references: [id])

  @@unique([customerId, skuId])
  @@map("wishlist_items")
}

model SupportTicket {
  id             String          @id @default(uuid())
  ticketNo       String          @unique @map("ticket_no")
  customerId     String?         @map("customer_id")
  requesterEmail String?         @map("requester_email")
  subject        String
  category       String          @default("general")
  priority       String          @default("normal")
  status         TicketStatus    @default(open)
  assigneeId     String?         @map("assignee_id")
  relatedOrderId String?         @map("related_order_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  customer       Customer?       @relation(fields: [customerId], references: [id])
  assignee       User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  messages       TicketMessage[]

  @@index([status, assigneeId])
  @@map("support_tickets")
}

model TicketMessage {
  id         String        @id @default(uuid())
  ticketId   String        @map("ticket_id")
  authorId   String?       @map("author_id")
  body       String
  isStaff    Boolean       @default(false) @map("is_staff")
  createdAt  DateTime      @default(now()) @map("created_at")
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_messages")
}

model Promotion {
  id          String    @id @default(uuid())
  code        String    @unique
  description String?
  type        String
  amount      Decimal   @db.Decimal(18, 4)
  minSpend    Decimal   @default(0) @map("min_spend") @db.Decimal(18, 4)
  active      Boolean   @default(true)
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  usageLimit  Int?      @map("usage_limit")
  usedCount   Int       @default(0) @map("used_count")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("promotions")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  prevHash   String?  @map("prev_hash")
  entryHash  String?  @map("entry_hash")
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String   @id @default(uuid())
  aggregateType String   @map("aggregate_type")
  aggregateId   String   @map("aggregate_id")
  eventType     String   @map("event_type")
  payload       Json
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  processedAt   DateTime? @map("processed_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String?   @map("user_id")
  channel   String
  template  String
  payload   Json
  status    String    @default("queued")
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("notifications")
}

model IdempotencyKey {
  key       String   @id
  userId    String?  @map("user_id")
  response  Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("idempotency_keys")
}

model FeatureFlag {
  key   String @id
  value String

  @@map("feature_flags")
}
